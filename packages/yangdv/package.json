{
  "name": "yangdv",
  "version": "0.0.1",
  "description": "Yang Design Vue3 Component Library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangone-x/yangone.git",
    "directory": "packages/yangdv"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "run-s build:esm build:vite:parallel build:verify",
    "build:verify": "tsx ./scripts/verify-browser-bundle.ts",
    "build:esm": "tsdown",
    "build:vite:parallel": "run-p build:umd build:full-esm",
    "build:full-esm": "vite build --config ./vite.esm.config.ts",
    "build:umd": "vite build",
    "prepublish": "pnpm build"
  },
  "files": [
    "README.md",
    "dist",
    "global.d.ts",
    "package.json"
  ],
  "sideEffects": [
    "./dist/reset.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": [
        "./dist/utils/*.d.ts",
        "./dist/utils/*/index.d.ts"
      ],
      "import": [
        "./dist/utils/*.js",
        "./dist/utils/*/index.js"
      ],
      "default": [
        "./dist/utils/*.js",
        "./dist/utils/*/index.js"
      ]
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": [
        "./dist/hooks/*.d.ts",
        "./dist/hooks/*/index.d.ts"
      ],
      "import": [
        "./dist/hooks/*.js",
        "./dist/hooks/*/index.js"
      ],
      "default": [
        "./dist/hooks/*.js",
        "./dist/hooks/*/index.js"
      ]
    },
    "./dist/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "import": [
        "./dist/*.js",
        "./dist/*/index.js"
      ],
      "default": [
        "./dist/*.js",
        "./dist/*/index.js"
      ]
    },
    "./dist/reset.css": "./dist/reset.css",
    "./package.json": "./package.json"
  },
  "contributes": {
    "html": {
      "customData": [
        "./web-tags.json"
      ]
    }
  },
  "dependencies": {
    "@popperjs/core": "catalog:prod",
    "@vueuse/core": "catalog:prod",
    "dayjs": "catalog:",
    "defu": "catalog:prod",
    "lodash-es": "catalog:prod",
    "vue": "catalog:prod"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "csstype": "catalog:prod",
    "vite-plugin-dayjs": "catalog:dev",
    "vite-plugin-inspect": "catalog:dev",
    "vite-plugin-tsx-resolve-types": "catalog:dev"
  },
  "web-types": "web-types.json",
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ]
}
